# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# App URLs (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# Public API: legacy shared token, only honoured while the database holds a
# single school. Prefer per-school tokens minted under School Profile.
PUBLIC_API_TOKEN=

# Column that carries the school reference (default school_id). Tenant
# scoping is always on; there is no longer an enable/strict switch.
SAAS_TENANT_COLUMN=school_id

# Secret for /api/cron/* (used when pg_cron is unavailable)
CRON_SECRET=

# SMS (optional). Termii is preferred; Twilio used if Termii is unset.
TERMII_API_KEY=
TERMII_SENDER_ID=SkoolPro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
